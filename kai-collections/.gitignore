test-results/
playwright-report/
*.log
.DS_Store

# ---------------------------------------------------------------------------
# Third-party media stays out of this public repository.
# KAI's photographs and logo are referenced by URL from KAI's own CDN. Anything
# that captures them — the live BEFORE captures of kaicollections.com, the film
# plates (screenshots of this concept showing KAI's photography), site
# screenshots, the contact sheet and the film itself — is generated locally
# (`npm run capture:before`, `npm run render`, `npm run shots`) and delivered
# to the client separately. See README → "Rights & media".
# ---------------------------------------------------------------------------
public/film/before/*
!public/film/before/.gitkeep
public/film/plates/*
!public/film/plates/.gitkeep
output/before/
output/screenshots/
output/showcase-contact-sheet.png
output/frames/
# (*.mp4 is ignored by the repository root .gitignore; the film is not committed)
