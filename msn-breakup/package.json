{
  "name": "msn-breakup",
  "version": "1.0.0",
  "private": true,
  "description": "A 2007 MSN Messenger breakup, recreated in code: the film (9:16 master), a three-video 4:5 Instagram carousel (the film, When You’re Gone in Windows Media Player, her Tumblr post and STAY TUNED.), a teaser and stills. Standalone content project (Remotion). Unofficial nostalgic homage by Omar Akram; not affiliated with Microsoft, Tumblr or In Your Shoe.",
  "type": "module",
  "scripts": {
    "dev": "remotion studio src/index.ts",
    "sfx": "node scripts/make-sfx.mjs",
    "typecheck": "tsc --noEmit",
    "test": "node --test tests/*.test.mjs",
    "import:song": "node scripts/import-song.mjs",
    "render:reel": "node scripts/render.mjs HeroReel out/msn-breakup-reel.mp4",
    "render:reel:first-cut": "node scripts/render.mjs HeroReelOriginal out/msn-breakup-reel-first-cut.mp4",
    "render:carousel": "node scripts/render-carousel.mjs",
    "render:carousel:film": "node scripts/render-carousel.mjs --only=1",
    "render:carousel:player": "node scripts/render-carousel.mjs --only=2",
    "render:carousel:tumblr": "node scripts/render-carousel.mjs --only=3",
    "render:teaser": "node scripts/render.mjs Teaser out/msn-breakup-teaser.mp4",
    "render:stills": "node scripts/render-stills.mjs",
    "render:all": "npm run render:reel && npm run render:carousel && npm run render:teaser && npm run render:stills",
    "manifest": "node scripts/manifest.mjs",
    "cues": "node scripts/print-cues.mjs",
    "qa": "npm run typecheck && npm test && node scripts/qa.mjs",
    "qa:regression": "node scripts/regression.mjs"
  },
  "dependencies": {
    "@remotion/bundler": "4.0.534",
    "@remotion/cli": "4.0.534",
    "@remotion/fonts": "4.0.534",
    "@remotion/media-utils": "4.0.534",
    "@remotion/renderer": "4.0.534",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "remotion": "4.0.534"
  },
  "devDependencies": {
    "@fontsource/archivo-black": "5.3.0",
    "@fontsource/arimo": "5.3.0",
    "@fontsource/comic-neue": "5.3.0",
    "@fontsource/fira-sans": "5.3.0",
    "@fontsource/gelasio": "5.3.0",
    "@types/react": "19.3.0",
    "typescript": "5.9.3"
  },
  "engines": {
    "node": ">=20"
  }
}
