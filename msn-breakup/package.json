{
  "name": "msn-breakup",
  "version": "1.0.0",
  "private": true,
  "description": "A 2007 MSN Messenger breakup, recreated in code as a vertical reel, teaser and carousel stills. Standalone content project (Remotion). Unofficial nostalgic homage by Omar Akram; not affiliated with Microsoft or In Your Shoe.",
  "type": "module",
  "scripts": {
    "dev": "remotion studio src/index.ts",
    "sfx": "node scripts/make-sfx.mjs",
    "typecheck": "tsc --noEmit",
    "render:teaser": "remotion render src/index.ts Teaser out/msn-breakup-teaser.mp4 --crf=17",
    "render:reel": "remotion render src/index.ts HeroReel out/msn-breakup-reel.mp4 --crf=17",
    "render:stills": "node scripts/render-stills.mjs",
    "render:all": "npm run render:teaser && npm run render:reel && npm run render:stills",
    "cues": "node scripts/print-cues.mjs"
  },
  "dependencies": {
    "@remotion/cli": "4.0.534",
    "@remotion/fonts": "4.0.534",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "remotion": "4.0.534"
  },
  "devDependencies": {
    "@fontsource/arimo": "5.3.0",
    "@fontsource/comic-neue": "5.3.0",
    "@fontsource/fira-sans": "5.3.0",
    "@types/react": "19.3.0",
    "typescript": "5.9.3"
  },
  "engines": {
    "node": ">=20"
  }
}
